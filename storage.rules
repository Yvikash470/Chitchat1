rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isConversationMember(conversationId) {
      return signedIn() && request.auth.uid in
        firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.members;
    }

    match /chatMedia/{conversationId}/{userId}/{fileName} {
      allow read: if isConversationMember(conversationId);
      allow create: if isConversationMember(conversationId)
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
      allow update: if false;
      allow delete: if isConversationMember(conversationId) && request.auth.uid == userId;
    }

    match /statuses/{userId}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
