rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isConversationMember(conversationId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }

    // Signed-in users can discover registered accounts by email to start chats.
    // Keep private profile fields out of this document; only publish these fields.
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email is string;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdBy == request.auth.uid
        && ((request.resource.data.type == 'private' && request.resource.data.members.size() == 2)
          || (request.resource.data.type == 'group' && request.resource.data.members.size() >= 2));
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'updatedAt', 'lastMessageId', 'lastSenderId', 'hiddenFor'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hiddenFor'])
          || (
            request.resource.data.get('hiddenFor', []) is list
            && request.resource.data.get('hiddenFor', []).toSet().difference(resource.data.get('hiddenFor', []).toSet()).size() <= 1
            && (
              request.resource.data.get('hiddenFor', []).toSet().difference(resource.data.get('hiddenFor', []).toSet()).size() == 0
              || request.resource.data.get('hiddenFor', []).toSet().difference(resource.data.get('hiddenFor', []).toSet()).hasAny([request.auth.uid])
            )
            && resource.data.get('hiddenFor', []).toSet().difference(request.resource.data.get('hiddenFor', []).toSet()).size() <= 1
            && (
              resource.data.get('hiddenFor', []).toSet().difference(request.resource.data.get('hiddenFor', []).toSet()).size() == 0
              || resource.data.get('hiddenFor', []).toSet().difference(request.resource.data.get('hiddenFor', []).toSet()).hasAny([request.auth.uid])
            )
          )
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && (request.resource.data.mediaUrl == null
            || (request.resource.data.mediaUrl is string
              && request.resource.data.mediaType in ['image', 'video']));
        allow update: if false;
        allow delete: if isConversationMember(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Status updates are visible only to signed-in Chit Chat users.
    match /statuses/{statusId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /callLogs/{callId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
  }
}
